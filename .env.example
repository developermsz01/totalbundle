# Shopify App Environment Variables
# -------------------------------------------------------------
# When developing locally with Shopify CLI (`npm run dev`),
# Shopify CLI automatically supplies these variables and manages the tunnel.
#
# Alternatively, you can run `npm run env pull` after linking (`npm run config:link`)
# to pull these values automatically from your Shopify Partner Dashboard.

# Your Shopify App Client ID (API Key)
SHOPIFY_API_KEY=

# Your Shopify App Client Secret
SHOPIFY_API_SECRET=

# Scopes needed for your app (must match shopify.app.toml)
SCOPES=write_products,read_products,write_discounts,read_discounts

# Public URL of your app (provided automatically by Cloudflare tunnel during `npm run dev`)
SHOPIFY_APP_URL=

# Port for local server (default: 3000)
PORT=3000
