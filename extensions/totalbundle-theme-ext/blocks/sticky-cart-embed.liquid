{% comment %}
  TotalBundle - Sticky Add to Cart App Embed Block
  Target: body (renders directly at page root for proper sticky behavior without section container constraints)
  All settings are managed seamlessly from the TotalBundles App Dashboard.
{% endcomment %}

{%- if product != blank -%}
  {% render 'sticky-cart-component', block: block %}
{%- endif -%}

{% render 'cart-drawer-component', block: block %}

{% schema %}
{
  "name": "Sticky Add to Cart",
  "target": "body",
  "javascript": "sticky-cart.js",
  "stylesheet": "sticky-cart.css",
  "settings": []
}
{% endschema %}
