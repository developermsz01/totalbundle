{% comment %}
  TotalBundle - Sticky Add to Cart Section App Block
  Target: section (can be added directly inside product sections on Online Store 2.0 themes)
  All settings are managed seamlessly from the TotalBundles App Dashboard.
{% endcomment %}

{%- if product != blank -%}
  {% render 'sticky-cart-component', block: block %}
{%- endif -%}

{% schema %}
{
  "name": "Sticky Add to Cart",
  "target": "section",
  "templates": ["product"],
  "javascript": "sticky-cart.js",
  "stylesheet": "sticky-cart.css",
  "settings": []
}
{% endschema %}
