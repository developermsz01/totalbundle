{% comment %}
  TotalBundle - Sticky Add to Cart Component
  Renders product thumbnail, title, variant dropdown, price, quantity stepper, and CTA.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign position = block.settings.position | default: 'bottom'
  assign desktop_visibility = block.settings.desktop_visibility | default: 'scroll'
  assign show_on_mobile = block.settings.show_on_mobile
  if show_on_mobile == nil
    assign show_on_mobile = true
  endif
  assign show_thumbnail = block.settings.show_thumbnail
  if show_thumbnail == nil
    assign show_thumbnail = true
  endif
  assign show_compare_at = block.settings.show_compare_at_price
  if show_compare_at == nil
    assign show_compare_at = true
  endif
  assign show_quantity = block.settings.show_quantity
  if show_quantity == nil
    assign show_quantity = true
  endif
  assign button_text = block.settings.button_text | default: 'Add to Cart'
  assign sold_out_text = block.settings.sold_out_text | default: 'Sold Out'
-%}

{%- if product != blank -%}
<aside
  id="totalbundle-sticky-cart"
  class="tb-sticky-cart tb-sticky-cart--{{ position }} tb-sticky-cart--hidden"
  role="region"
  aria-label="{{ 'sticky_cart.bar_label' | t | default: 'Sticky add to cart bar' }}"
  data-product-id="{{ product.id }}"
  data-selected-variant-id="{{ current_variant.id }}"
  data-desktop-visibility="{{ desktop_visibility }}"
  data-show-on-mobile="{{ show_on_mobile }}"
  data-button-text="{{ button_text | escape }}"
  data-sold-out-text="{{ sold_out_text | escape }}"
  style="
    --tb-bg-color: {{ block.settings.bg_color | default: '#ffffff' }};
    --tb-text-color: {{ block.settings.text_color | default: '#121212' }};
    --tb-btn-bg: {{ block.settings.button_bg_color | default: '#121212' }};
    --tb-btn-text: {{ block.settings.button_text_color | default: '#ffffff' }};
    --tb-btn-hover-bg: {{ block.settings.button_hover_bg_color | default: '#2e2e2e' }};
    --tb-border-radius: {{ block.settings.border_radius | default: 8 }}px;
    --tb-padding: {{ block.settings.padding | default: 12 }}px;
  "
>
  <div class="tb-sticky-cart__inner">
    <!-- Product Info Section -->
    <div class="tb-sticky-cart__product">
      {%- if show_thumbnail -%}
        <div class="tb-sticky-cart__media">
          {%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}
          {%- if featured_image != blank -%}
            <img
              class="tb-sticky-cart__img"
              src="{{ featured_image | image_url: width: 140 }}"
              alt="{{ featured_image.alt | default: product.title | escape }}"
              width="60"
              height="60"
              loading="lazy"
            >
          {%- else -%}
            <div class="tb-sticky-cart__img-placeholder" aria-hidden="true">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="tb-sticky-cart__meta">
        <h2 class="tb-sticky-cart__title" title="{{ product.title | escape }}">
          {{ product.title }}
        </h2>
        <div class="tb-sticky-cart__prices" aria-live="polite">
          {%- if show_compare_at and current_variant.compare_at_price > current_variant.price -%}
            <s class="tb-sticky-cart__compare-price">
              <span class="visually-hidden">{{ 'sticky_cart.regular_price' | t | default: 'Regular price' }}: </span>
              {{ current_variant.compare_at_price | money }}
            </s>
          {%- endif -%}
          <span class="tb-sticky-cart__price">
            <span class="visually-hidden">{{ 'sticky_cart.sale_price' | t | default: 'Sale price' }}: </span>
            {{ current_variant.price | money }}
          </span>
          {%- if show_compare_at and current_variant.compare_at_price > current_variant.price -%}
            <span class="tb-sticky-cart__badge">
              {{ 'sticky_cart.save' | t | default: 'Save' }}
              {{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}%
            </span>
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- Actions Section: Variant, Quantity, and Button -->
    <div class="tb-sticky-cart__actions">
      {%- if product.has_only_default_variant == false and product.variants.size > 1 -%}
        <div class="tb-sticky-cart__variant-wrapper">
          <label for="tb-variant-select-{{ product.id }}" class="visually-hidden">
            {{ 'sticky_cart.select_variant' | t | default: 'Select variant' }}
          </label>
          <select
            id="tb-variant-select-{{ product.id }}"
            class="tb-sticky-cart__variant-select"
            aria-label="{{ 'sticky_cart.select_variant' | t | default: 'Select variant' }}"
          >
            {%- for variant in product.variants -%}
              <option
                value="{{ variant.id }}"
                {% if variant.id == current_variant.id %}selected{% endif %}
                data-price="{{ variant.price }}"
                data-compare-at-price="{{ variant.compare_at_price | default: 0 }}"
                data-available="{{ variant.available }}"
                data-image="{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 140 }}{% else %}{{ product.featured_image | image_url: width: 140 }}{% endif %}"
              >
                {{ variant.title }}{% unless variant.available %} - {{ 'sticky_cart.sold_out' | t | default: 'Sold Out' }}{% endunless %}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- else -%}
        <input type="hidden" class="tb-sticky-cart__single-variant-id" value="{{ current_variant.id }}">
      {%- endif -%}

      {%- if show_quantity -%}
        <div class="tb-sticky-cart__qty-picker">
          <button
            type="button"
            class="tb-sticky-cart__qty-btn tb-sticky-cart__qty-btn--minus"
            aria-label="{{ 'sticky_cart.decrease_quantity' | t | default: 'Decrease quantity' }}"
          >
            <span aria-hidden="true">&#8722;</span>
          </button>
          <input
            type="number"
            class="tb-sticky-cart__qty-input"
            value="1"
            min="1"
            step="1"
            aria-label="{{ 'sticky_cart.quantity' | t | default: 'Quantity' }}"
          >
          <button
            type="button"
            class="tb-sticky-cart__qty-btn tb-sticky-cart__qty-btn--plus"
            aria-label="{{ 'sticky_cart.increase_quantity' | t | default: 'Increase quantity' }}"
          >
            <span aria-hidden="true">&#43;</span>
          </button>
        </div>
      {%- else -%}
        <input type="hidden" class="tb-sticky-cart__qty-input" value="1">
      {%- endif -%}

      <button
        type="button"
        class="tb-sticky-cart__add-btn"
        {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}
      >
        <span class="tb-sticky-cart__btn-text">
          {%- if current_variant.available -%}
            {{ button_text }}
          {%- else -%}
            {{ sold_out_text }}
          {%- endif -%}
        </span>
        <span class="tb-sticky-cart__spinner" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Live Status Region for Screen Readers -->
  <div class="visually-hidden" role="status" aria-live="polite" class="tb-sticky-cart__status-msg"></div>

  <!-- Product Configuration Payload for JavaScript -->
  <script type="application/json" class="tb-sticky-cart__product-json">
    {
      "productId": {{ product.id | json }},
      "title": {{ product.title | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "selectedVariantId": {{ current_variant.id | json }},
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id | json }},
            "title": {{ variant.title | json }},
            "price": {{ variant.price | json }},
            "compare_at_price": {{ variant.compare_at_price | json }},
            "available": {{ variant.available | json }},
            "featured_image": {%- if variant.featured_image -%}{{ variant.featured_image | image_url: width: 140 | json }}{%- else -%}{{ product.featured_image | image_url: width: 140 | json }}{%- endif -%},
            "options": {{ variant.options | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
</aside>
{%- endif -%}
